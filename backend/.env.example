# App
APP_NAME=PSY OS
APP_ENV=development
APP_URL=http://localhost:8000
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL=postgresql+asyncpg://psyos:psyos_dev@localhost:5432/psyos

# Redis
REDIS_URL=redis://localhost:6379/0

# AI (optional for local dev without keys)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_SUMMARY_MODEL=gpt-4o-mini
OPENAI_INSIGHT_MODEL=gpt-4o-mini
OPENAI_COMPLEX_MODEL=gpt-4o
WHISPER_MODEL=whisper-1
AI_ENABLED=false
AI_MAX_REQUESTS_PER_PSYCHOLOGIST_PER_DAY=20
AI_CACHE_TTL_HOURS=24
WHISPER_MAX_MINUTES=10

# Files
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# CORS (* for free HTTP deploy; restrict in production)
CORS_ORIGINS=*

# Frontend (served by same app)
SERVE_FRONTEND=true
